<?xml version="1.0" encoding="UTF-8"?>
<!-- Rendered by matugen (~/.config/matugen/templates/bat.tmTheme) via the
     [templates.bat] entry in ~/.config/matugen/config.toml, on every
     wallpaper switch. Output goes to ~/.config/bat/themes/matugen.tmTheme;
     bat only reads compiled theme caches, so the post_hook runs
     a `bat cache` rebuild (the post_hook) to recompile them (bat has no live-reload - each
     invocation is a fresh process that already picks up the new cache).

     Scope choices mirror the nvim colorscheme template
     (dotfiles/nvim/matugen/colorscheme.lua) and ghostty's ANSI mapping so
     all three read as the same theme:
       bg = surface, fg = on_surface, comments = on_surface_variant.
       string/character = green, numeric/boolean/language constants =
       magenta, named constants/support.constant = cyan, keyword = red,
       storage (types/modifiers) = yellow, entity.name.function/support.
       function = blue, entity.name.type/class/support.class = yellow,
       punctuation/operator = on_surface_variant, variable = on_surface,
       variable.parameter = on_surface_variant, variable.language = magenta.
     No bold/italic anywhere (fontStyle left empty), matching the nvim
     theme's "no bold anywhere" rule - only links keep underline, which
     isn't bold or italic. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
