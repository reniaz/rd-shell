# Rendered by matugen on every wallpaper switch into
# ~/.local/share/color-schemes/Matugen.colors, then applied to the live KDE
# session by `plasma-apply-colorscheme Matugen` (see the [templates.kde]
# post_hook in ~/.config/matugen/config.toml). plasma-apply-colorscheme both
# rewrites ~/.config/kdeglobals with these sections and notifies every running
# Qt/KDE app over D-Bus (Dolphin, Ark, kdialog, KDE file-open dialogs in any
# app using QT_QPA_PLATFORMTHEME=kde) -- no restart needed.
#
# Section/key layout copied from /usr/share/color-schemes/BreezeDark.colors so
# every app-visible slot Breeze fills is also filled here; only the values
# change. Role mapping, light-on-dark surface ladder (mode is always dark,
# Caelus.qml):
#   View (lists/text areas)   -> surface_container_low / surface_container
#   Window (general chrome)   -> surface / surface_container_low
#   Button                    -> surface_container / surface_container_high
#   Selection (highlighted)   -> primary / primary_container, text on_primary
#   Tooltip                   -> surface_container_high / surface_container_highest
#   Complementary (flyouts, e.g. Dolphin's places panel background) -> surface_container_lowest
#   Header (toolbars/path bars) -> surface_container, dimmer when [Inactive]
#   WM (titlebar)              -> surface_container_high active, surface_container_low inactive
# Foreground ladder: ForegroundNormal/Active = on_surface / primary,
# ForegroundInactive = on_surface_variant. Link/Visited/Negative/Neutral/
# Positive reuse the same six fixed ANSI-style custom colors every other
# template in this repo uses (config.custom_colors: blue/magenta/red/yellow/
# green), so KDE's link-blue, visited-purple, error-red, warning-orange and
# success-green track the wallpaper the same way btop's and ghostty's do,
# without ever going monochrome against a single-hue Material palette.

[Colors:Button]
BackgroundAlternate={{colors.surface_container_high.default.red}},{{colors.surface_container_high.default.green}},{{colors.surface_container_high.default.blue}}
BackgroundNormal={{colors.surface_container.default.red}},{{colors.surface_container.default.green}},{{colors.surface_container.default.blue}}
DecorationFocus={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
DecorationHover={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
ForegroundActive={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
ForegroundInactive={{colors.on_surface_variant.default.red}},{{colors.on_surface_variant.default.green}},{{colors.on_surface_variant.default.blue}}
ForegroundLink={{colors.blue.default.red}},{{colors.blue.default.green}},{{colors.blue.default.blue}}
ForegroundNegative={{colors.red.default.red}},{{colors.red.default.green}},{{colors.red.default.blue}}
ForegroundNeutral={{colors.yellow.default.red}},{{colors.yellow.default.green}},{{colors.yellow.default.blue}}
ForegroundNormal={{colors.on_surface.default.red}},{{colors.on_surface.default.green}},{{colors.on_surface.default.blue}}
ForegroundPositive={{colors.green.default.red}},{{colors.green.default.green}},{{colors.green.default.blue}}
ForegroundVisited={{colors.magenta.default.red}},{{colors.magenta.default.green}},{{colors.magenta.default.blue}}

[Colors:Complementary]
BackgroundAlternate={{colors.surface_container_low.default.red}},{{colors.surface_container_low.default.green}},{{colors.surface_container_low.default.blue}}
BackgroundNormal={{colors.surface_container_lowest.default.red}},{{colors.surface_container_lowest.default.green}},{{colors.surface_container_lowest.default.blue}}
DecorationFocus={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
DecorationHover={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
ForegroundActive={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
ForegroundInactive={{colors.on_surface_variant.default.red}},{{colors.on_surface_variant.default.green}},{{colors.on_surface_variant.default.blue}}
ForegroundLink={{colors.blue.default.red}},{{colors.blue.default.green}},{{colors.blue.default.blue}}
ForegroundNegative={{colors.red.default.red}},{{colors.red.default.green}},{{colors.red.default.blue}}
ForegroundNeutral={{colors.yellow.default.red}},{{colors.yellow.default.green}},{{colors.yellow.default.blue}}
ForegroundNormal={{colors.on_surface.default.red}},{{colors.on_surface.default.green}},{{colors.on_surface.default.blue}}
ForegroundPositive={{colors.green.default.red}},{{colors.green.default.green}},{{colors.green.default.blue}}
ForegroundVisited={{colors.magenta.default.red}},{{colors.magenta.default.green}},{{colors.magenta.default.blue}}

